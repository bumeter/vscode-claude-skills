{
  "name": "bumeter-claude-skills",
  "displayName": "Claude Code Skills Manager — Install, Enable & Disable Skills",
  "description": "Manage Claude Code skills (Agent Skills, SKILL.md) in VS Code: install skills from skills.sh, git or a folder; enable, disable and remove them; see uses and token cost per skill. Kiro too. Local only. By Bumeter (unofficial, not made by Anthropic).",
  "version": "0.1.1",
  "publisher": "bumkom",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/bumeter/vscode-claude-skills"
  },
  "homepage": "https://bumeter.cc",
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude code",
    "claude code skills",
    "claude skills",
    "agent skills",
    "skills",
    "skill manager",
    "skills.sh",
    "SKILL.md",
    "install skills",
    "claude plugins",
    "claude",
    "anthropic",
    "kiro",
    "kiro skills",
    "ai agent",
    "ai",
    "context",
    "tokens",
    "bumeter"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2a1f4d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "claudeSkills.open",
        "title": "Open",
        "category": "Skill Manager",
        "icon": "$(book)"
      },
      {
        "command": "claudeSkills.install",
        "title": "Install Skill…",
        "category": "Skill Manager",
        "icon": "$(add)"
      },
      {
        "command": "claudeSkills.refresh",
        "title": "Refresh",
        "category": "Skill Manager",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "Claude Code Skills Manager",
      "properties": {
        "claudeSkills.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `bum` command. Empty: the one bundled with the extension, then `bum` on PATH."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle-bum": "node scripts/bundle-bum.mjs"
  },
  "devDependencies": {
    "@bumeter/vscode-kit": "^0.2.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "jsdom": "^25.0.0"
  },
  "bugs": {
    "url": "https://github.com/bumeter/vscode-claude-skills/issues"
  }
}
